# ═══════════════════════════════════════════════════════════════
#  Baubau Deal Finder — .env.example
#  Salin ke .env dan isi nilainya. JANGAN commit .env.
# ═══════════════════════════════════════════════════════════════

# ── Apify (scraping engine) ─────────────────────────────────
# Daftar gratis: https://apify.com — free tier 10.000 results/bulan
# Setelah daftar, buka Settings → Integrations → API Token
APIFY_API_TOKEN=

# ── Email (notifikasi deal) ──────────────────────────────────
# SMTP untuk kirim email notifikasi
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
